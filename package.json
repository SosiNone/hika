{
  "name": "hika",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sci-fi HUD trail explorer for Swiss hiking routes, built on swisstopo open data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:region": "tsx scripts/build-region.ts",
    "check:region": "tsx scripts/check-region.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "sharp": "^0.35.5"
  }
}
